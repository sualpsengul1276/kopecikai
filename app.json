{
  "expo": {
    "name": "Köpecik",
    "slug": "kopecikai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kopecikai",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2F6FD0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kopecikai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F6FD0"
      },
      "package": "com.kopecikai.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
